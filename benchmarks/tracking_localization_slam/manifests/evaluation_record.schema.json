{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Trajectory Evaluation Record",
  "type":"object",
  "required":["run_id","evaluator","evaluator_commit","alignment","metrics"],
  "properties":{
    "run_id":{"type":"string"},
    "evaluator":{"type":"string"},
    "evaluator_commit":{"type":"string"},
    "alignment":{"type":"object","required":["type"],"properties":{"type":{"type":"string"},"scale_correction":{"type":"boolean"}}},
    "association":{"type":"object"},
    "metrics":{"type":"object","properties":{
      "ate_rmse_m":{"type":["number","null"],"minimum":0},
      "rpe_translation_rmse_m":{"type":["number","null"],"minimum":0},
      "rpe_rotation_rmse_deg":{"type":["number","null"],"minimum":0},
      "estimated_pose_count":{"type":"integer","minimum":0},
      "associated_pose_count":{"type":"integer","minimum":0}
    }},
    "valid":{"type":"boolean"},
    "invalid_reason":{"type":["string","null"]}
  }
}
